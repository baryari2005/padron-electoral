generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  relationMode      = "prisma"
}

model Usuario {
  id        String   @id @default(uuid())
  userId    String   @unique
  email     String   @unique
  password  String
  nombre    String?
  apellido  String?
  avatarUrl String?
  rolId     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rol       Rol      @relation(fields: [rolId], references: [id])

  @@index([rolId])
}

model Rol {
  id       Int             @id @default(autoincrement())
  nombre   String          @unique
  usuarios Usuario[]
  permisos PermisoPorRol[]
}

model Permiso {
  id          Int             @id @default(autoincrement())
  clave       String          @unique
  descripcion String
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  accion      String
  modulo      String
  roles       PermisoPorRol[]
}

model PermisoPorRol {
  id        String    @id @default(uuid())
  rolId     Int
  permisoId Int
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  rol       Rol       @relation(fields: [rolId], references: [id])
  permiso   Permiso   @relation(fields: [permisoId], references: [id])

  @@unique([rolId, permisoId])
  @@index([rolId])
  @@index([permisoId])
}

model Pais {
  id         Int         @id @default(autoincrement())
  nombre     String      @unique
  userId     String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  provincias Provincia[]

  @@index([userId])
}

model Provincia {
  id          Int         @id @default(autoincrement())
  nombre      String
  paisId      Int
  userId      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  pais        Pais        @relation(fields: [paisId], references: [id])
  localidades Localidad[]

  @@unique([nombre, paisId])
  @@index([userId])
  @@index([paisId])
}

model Localidad {
  id          Int       @id @default(autoincrement())
  nombre      String
  provinciaId Int
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  provincia   Provincia @relation(fields: [provinciaId], references: [id])

  @@unique([nombre, provinciaId])
  @@index([userId])
  @@index([provinciaId])
}

model MesasPorEstablecimiento {
  id                Int             @id @default(autoincrement())
  numero            Int
  establecimientoId Int
  userId            String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  establecimiento   Establecimiento @relation(fields: [establecimientoId], references: [id])
  mesaEscrutada     MesaEscrutada?  @relation("MesasPorEstablecimientoToEscrutada")
  stats             MesaStats?      @relation("Mesa_MesaStats")

  @@unique([numero, establecimientoId])
  @@index([userId])
  @@index([establecimientoId])
  @@index([deletedAt])
  @@index([establecimientoId], map: "idx_mesas_est")
}

model Establecimiento {
  id                      Int                       @id @default(autoincrement())
  nombre                  String
  direccion               String
  circuitoId              Int
  profileImage            String?
  userId                  String
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?
  circuito                Circuito                  @relation(fields: [circuitoId], references: [id])
  mesasPorEstablecimiento MesasPorEstablecimiento[]
  padrones                PadronElectoral[]
  mesasEscrutadas         MesaEscrutada[]
  stats                   EstablecimientoStats?     @relation("Est_EstablecimientoStats")

  @@unique([nombre, direccion])
  @@index([deletedAt])
  @@index([userId])
  @@index([circuitoId])
  @@index([circuitoId], map: "idx_estab_circ")
}

model Circuito {
  id               Int               @id @default(autoincrement())
  codigo           String            @unique
  nombre           String
  userId           String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  establecimientos Establecimiento[]
  padrones         PadronElectoral[]
  mesasEscrutadas  MesaEscrutada[]
  stats            CircuitoStats?    @relation("Circ_CircuitoStats")

  @@index([userId])
  @@index([deletedAt])
}

model PadronElectoral {
  id                Int             @id @default(autoincrement())
  distrito          String
  tipoEjemplar      String
  numeroMatricula   String          @unique
  apellido          String
  nombre            String
  clase             Int
  genero            String
  domicilio         String
  seccion           String
  localidad         String
  codigoPostal      String
  tipoNacionalidad  String
  numeroMesa        Int
  ordenMesa         Int
  votoSiNo          String
  circuitoId        Int
  establecimientoId Int
  userId            String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  votedAt           DateTime?       @default(now())
  votedBy           String?
  circuito          Circuito        @relation(fields: [circuitoId], references: [id])
  establecimiento   Establecimiento @relation(fields: [establecimientoId], references: [id])

  @@index([userId])
  @@index([deletedAt])
  @@index([circuitoId])
  @@index([establecimientoId])
  @@index([circuitoId], map: "idx_padron_circ")
  @@index([establecimientoId], map: "idx_padron_est")
  @@index([establecimientoId, numeroMesa], map: "idx_padron_est_num")
}

model MesaEscrutada {
  id                     Int                              @id @default(autoincrement())
  numero                 Int
  seccion                String?
  circuitoId             Int
  establecimientoId      Int
  resumenJson            Json?
  userId                 String
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  deletedAt              DateTime?
  circuito               Circuito                         @relation(fields: [circuitoId], references: [id])
  establecimiento        Establecimiento                  @relation(fields: [establecimientoId], references: [id])
  resultadosAgrupaciones ResultadoPorAgrupacionPolitica[]
  resultadosEspeciales   ResultadoVotosEspeciales[]
  firmas                 Firma[]
  resultadoFinal         ResultadoPorMesa?
  diferenciasCargos      DiferenciasPorCargosPoliticos[]
  mesaPorEstablecimiento MesasPorEstablecimiento?         @relation("MesasPorEstablecimientoToEscrutada", fields: [numero, establecimientoId], references: [numero, establecimientoId])

  @@unique([numero, establecimientoId])
  @@index([establecimientoId])
  @@index([userId])
  @@index([deletedAt])
  @@index([circuitoId])
}

model ResultadoPorAgrupacionPolitica {
  id                 Int                @id @default(autoincrement())
  mesaId             Int
  categoriaId        Int
  agrupacionId       Int
  votos              Int
  mesaEscrutada      MesaEscrutada      @relation(fields: [mesaId], references: [id])
  cargoPolitico      CargoPolitico      @relation(fields: [categoriaId], references: [id])
  agrupacionPolitica AgrupacionPolitica @relation(fields: [agrupacionId], references: [id])

  @@index([mesaId])
  @@index([categoriaId])
  @@index([agrupacionId])
}

model ResultadoPorMesa {
  id               Int           @id @default(autoincrement())
  mesaId           Int           @unique
  electoresVotaron Int
  sobresEnUrna     Int
  diferencia       Int
  mesaEscrutada    MesaEscrutada @relation(fields: [mesaId], references: [id])
}

model ResultadoVotosEspeciales {
  id                    Int           @id @default(autoincrement())
  mesaId                Int
  categoriaId           Int
  votosNulos            Int
  votosEnBlanco         Int
  votosRecurridos       Int
  votosImpugnados       Int
  votosComandoElectoral Int
  mesaEscrutada         MesaEscrutada @relation(fields: [mesaId], references: [id])
  cargoPolitico         CargoPolitico @relation(fields: [categoriaId], references: [id])

  @@unique([mesaId, categoriaId])
  @@index([categoriaId])
}

model DiferenciasPorCargosPoliticos {
  id            Int           @id @default(autoincrement())
  mesaId        Int
  categoriaId   Int
  diferencia    Int
  mesaEscrutada MesaEscrutada @relation(fields: [mesaId], references: [id])
  cargoPolitico CargoPolitico @relation(fields: [categoriaId], references: [id])

  @@unique([mesaId, categoriaId])
  @@index([categoriaId])
}

model Firma {
  id                 Int                 @id @default(autoincrement())
  mesaId             Int
  nombre             String
  dni                String
  agrupacionId       Int?
  cargoId            Int
  mesaEscrutada      MesaEscrutada       @relation(fields: [mesaId], references: [id])
  cargoPolitico      CargoPolitico       @relation(fields: [cargoId], references: [id])
  agrupacionPolitica AgrupacionPolitica? @relation(fields: [agrupacionId], references: [id])

  @@index([mesaId])
  @@index([cargoId])
  @@index([agrupacionId])
}

model CargoPolitico {
  id                     Int                              @id @default(autoincrement())
  nombre                 String                           @unique
  userId                 String
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  deletedAt              DateTime?
  orden                  Int?
  resultadosAgrupaciones ResultadoPorAgrupacionPolitica[]
  resultadosEspeciales   ResultadoVotosEspeciales[]
  diferenciasCargos      DiferenciasPorCargosPoliticos[]
  Firma                  Firma[]
  AgrupacionCargoPerm    AgrupacionCargoPerm[]

  @@index([userId])
  @@index([deletedAt])
}

model AgrupacionPolitica {
  id                     Int                              @id @default(autoincrement())
  nombre                 String                           @unique
  numero                 Int                              @unique
  profileImage           String?
  color_hex              String                           @default("#cccccc")
  userId                 String
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  deletedAt              DateTime?
  resultadosAgrupaciones ResultadoPorAgrupacionPolitica[]
  firmas                 Firma[]

  AgrupacionCargoPerm AgrupacionCargoPerm[]

  @@index([userId])
  @@index([deletedAt])
}

model Empresa {
  id          String     @id @default(uuid())
  userId      String
  nombre      String
  descripcion String?
  imagen      String?
  cif         String?
  telefono    String?
  pais        String?
  sitioWeb    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  contactos   Contacto[]
  eventos     Evento[]

  @@index([userId])
}

model Contacto {
  id        String   @id @default(uuid())
  empresaId String?
  nombre    String
  telefono  String?
  rol       String
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
}

model Evento {
  id          String   @id @default(uuid())
  empresaId   String?
  titulo      String
  inicio      DateTime
  todoElDia   Boolean
  formatoHora String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  empresa     Empresa? @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
}

model MesaStats {
  mesaId      Int                     @id
  padronTotal Int
  updatedAt   DateTime                @updatedAt
  mesa        MesasPorEstablecimiento @relation("Mesa_MesaStats", fields: [mesaId], references: [id])
}

model EstablecimientoStats {
  establecimientoId Int             @id
  padronTotal       Int
  mesasCount        Int
  updatedAt         DateTime        @updatedAt
  establecimiento   Establecimiento @relation("Est_EstablecimientoStats", fields: [establecimientoId], references: [id])
}

model CircuitoStats {
  circuitoId  Int      @id
  padronTotal Int
  mesasCount  Int
  updatedAt   DateTime @updatedAt
  circuito    Circuito @relation("Circ_CircuitoStats", fields: [circuitoId], references: [id])
}

model GlobalStats {
  id           Int      @id @default(1)
  padronTotal  Int
  mesasTotales Int
  updatedAt    DateTime @updatedAt
}

model Eleccion {
  id       Int                   @id @default(autoincrement())
  nombre   String
  fecha    DateTime?
  permisos AgrupacionCargoPerm[]
}

model AgrupacionCargoPerm {
  id           Int     @id @default(autoincrement())
  agrupacionId Int
  cargoId      Int
  eleccionId   Int? // null = aplica a todas las elecciones
  allowed      Boolean @default(true)

  agrupacion AgrupacionPolitica @relation(fields: [agrupacionId], references: [id])
  cargo      CargoPolitico      @relation(fields: [cargoId], references: [id])
  eleccion   Eleccion?          @relation(fields: [eleccionId], references: [id])

  @@unique([agrupacionId, cargoId, eleccionId]) // una sola regla por combinación
  @@index([cargoId])
  @@index([eleccionId])
  @@index([agrupacionId])
}
